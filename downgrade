#!/usr/bin/env bash
# steam_downgrader — manual Steam client downgrade helpers
set -euo pipefail
ROOT="$(cd "$(dirname "$0")" && pwd)"
CACHE="$ROOT/cache"
STEAM_DIR="${STEAM_DIR:-$HOME/.steam/debian-installation}"
PY="${PYTHON:-python3}"
export PYTHONPATH="$ROOT"

cmd="${1:-help}"
shift || true

case "$cmd" in
  fetch)
    exec "$PY" "$ROOT/fetch.py" --cache "$CACHE" "$@"
    ;;
  fetch-smart)
    exec "$PY" "$ROOT/fetch_smart.py" --cache "$CACHE" "$@"
    ;;
  fetch-by-date)
    exec "$PY" "$ROOT/fetch_steamtracking.py" --cache "$CACHE" --date "${1:?YYYY-MM-DD}" "${@:2}"
    ;;
  install)
    exec "$PY" "$ROOT/install.py" --steam-dir "$STEAM_DIR" "$@"
    ;;
  activate-pending)
    exec "$PY" "$ROOT/activate.py" --steam-dir "$STEAM_DIR" "$@"
    ;;
  apply-mirror)
    exec "$PY" "$ROOT/apply_mirror.py" --steam-dir "$STEAM_DIR" "$@"
    ;;
  force-sep2024)
    YES=()
    if [ "${1:-}" = -y ]; then YES=(--yes); shift; fi
    exec "$PY" "$ROOT/force_sep2024.py" --steam-dir "$STEAM_DIR" "${YES[@]}" "$@"
    ;;
  sync-steam)
    VER="${1:-1726088054}"
    exec "$PY" -c "
from pathlib import Path
from force_sep2024 import sync_steam_executable
sync_steam_executable(Path('$STEAM_DIR'), Path('$CACHE/$VER'))
" "$@"
    ;;
  status)
    exec "$PY" "$ROOT/status.py" --steam-dir "$STEAM_DIR" "$@"
    ;;
  list-cache)
    shopt -s nullglob
    for m in "$CACHE"/*/steam_client_ubuntu12.manifest; do
      "$PY" -c "from pathlib import Path; from steam_manifest import load_manifest; p=Path('$m'); _,v,_=load_manifest(p); print(f'{v}\t{p.parent}')"
    done
    ;;
  force-wayback)
    YES=()
    if [ "${1:-}" = -y ]; then YES=(--yes); shift; fi
    DATE="${1:?wayback timestamp e.g. 20241107150153}"
    shift
    MAN="${1:-steam_client_ubuntu12}"
    shift || true
    echo "=== Fetch $MAN from Wayback $DATE (Fastly fallback if Archive gaps) ==="
    "$PY" "$ROOT/fetch_smart.py" --cache "$CACHE" --wayback-date "$DATE" --manifest "$MAN" --jobs 6 "$@"
    VER=$("$PY" -c "
from pathlib import Path
from steam_manifest import load_manifest
import sys
ms=sorted(Path('$CACHE').glob('*/${MAN}.manifest'), key=lambda p: p.stat().st_mtime)
if not ms: sys.exit('no manifest in cache')
_, v, _ = load_manifest(ms[-1])
print(v)
")
    echo "=== Destructive install cache/$VER (stop Steam if running) ==="
    EXTRA=()
    if [ -n "${OVERLAY_MD5:-}" ]; then EXTRA+=(--overlay-md5 "$OVERLAY_MD5"); fi
    exec "$PY" "$ROOT/force_sep2024.py" --steam-dir "$STEAM_DIR" \
      --cache-version-dir "$CACHE/$VER" --manifest-basename "$MAN" "${YES[@]}" "${EXTRA[@]}"
    ;;
  lock-updates)
    cat >"$STEAM_DIR/steam.cfg" <<'EOF'
BootStrapperInhibitAll=enable
BootStrapperForceSelfUpdate=disable
EOF
    echo "wrote $STEAM_DIR/steam.cfg"
    ;;
  mirror)
    exec "$PY" "$ROOT/mirror.py" "$@"
    ;;
  sep-2024)
    DATE=20240913122103
    MANIFEST=steam_client_ubuntu12
    echo "=== Fetch Sep 2024 linux manifest ($MANIFEST) from Wayback $DATE ==="
    "$PY" "$ROOT/fetch.py" --cache "$CACHE" --wayback-date "$DATE" --manifest "$MANIFEST" "$@"
    VER=$("$PY" -c "
from pathlib import Path
from steam_manifest import load_manifest
import sys
d=Path('$CACHE')
ms=sorted(d.glob('*/${MANIFEST}.manifest'), key=lambda p: p.stat().st_mtime)
if not ms: sys.exit('no manifest in cache')
_, v, _ = load_manifest(ms[-1])
print(v)
")
    echo "=== Install cache/$VER into $STEAM_DIR ==="
    echo "Stop Steam first. Press Enter to continue or Ctrl-C."
    read -r
    "$PY" "$ROOT/install.py" --cache-version-dir "$CACHE/$VER" \
      --manifest-basename "$MANIFEST" --steam-dir "$STEAM_DIR"
    ;;
  verify-wayback)
    DATE="${1:-20240913122103}"
    for f in steam_client_steamrt64 steam_client_ubuntu12; do
      code=$(curl -sS -o /dev/null -w '%{http_code}' -m 20 \
        "http://web.archive.org/web/${DATE}if_/media.steampowered.com/client/${f}" || echo err)
      echo "$DATE $f -> HTTP $code"
    done
    ;;
  restore-current)
    rm -f "$STEAM_DIR/steam.cfg" "$STEAM_DIR/../steam/steam.cfg" 2>/dev/null || true
    rm -f "$STEAM_DIR/.steam-enable-steamrt64-client" 2>/dev/null || true
    cat <<EOF
Removed update lock (steam.cfg). To pull the current client from Valve:

  1. Quit Steam completely (do not use ./sep-steam).
  2. Run once:
       steam -forcesteamupdate -forcepackagedownload -exitsteam
  3. Start Steam normally: /usr/games/steam  (or your desktop launcher)

Steam will re-download packages and restore steamrt64/ if your bootstrap expects it.
If update fails or the client is broken, restore from a backup:
  ls -dt ~/.steam/client_backup_* ~/.steam/debian-installation/package_backup_* 2>/dev/null | head -3
See README.md § Restore to latest Steam.
EOF
    ;;
  help|*)
    cat <<EOF
steam_downgrader — manual downgrade toolkit (see README.md)

  ./downgrade status                    Show build, overlay md5, running Steam
  ./downgrade list-cache                List cached build ids under cache/
  ./downgrade verify-wayback [date]     Check archive has manifest names
  ./downgrade fetch-smart --wayback-date TS   Wayback + Fastly fallback for missing blobs
  ./downgrade fetch --wayback-date TS --manifest steam_client_ubuntu12
  ./downgrade force-wayback [-y] TS [manifest]   fetch-smart + destructive install
  ./downgrade force-sep2024 [-y]         Sep 2024 preset (cache 1726088054)
  ./downgrade sync-steam [buildid]       Fix ubuntu12_32/steam from cache
  ./downgrade sep-2024                 Preset: Sep 2024 ubuntu12 fetch+install
  ./downgrade install --cache-version-dir cache/VERSION --manifest-basename NAME
  ./downgrade activate-pending          Before launch: drop steam.cfg, quarantine steamrt64
  ./downgrade lock-updates              After downgrade succeeded
  ./downgrade mirror --cache-version-dir cache/VERSION --port 8765
  ./downgrade restore-current          Unlock updates + print restore steps

Env: STEAM_DIR (default ~/.steam/debian-installation)
EOF
    ;;
esac
